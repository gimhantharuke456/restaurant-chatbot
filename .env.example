# PostgreSQL
POSTGRES_USER=chatbot_user
POSTGRES_PASSWORD=chatbot_pass
POSTGRES_DB=restaurant_chatbot
DATABASE_URL=postgresql://chatbot_user:chatbot_pass@localhost:5432/restaurant_chatbot

# Redis
REDIS_URL=redis://localhost:6379

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_pass

# Firebase (service account JSON fields)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY=your_private_key
FIREBASE_CLIENT_EMAIL=your_client_email

# Gemini / Vertex AI
VERTEX_PROJECT_ID=your_gcp_project
VERTEX_LOCATION=us-central1
GEMINI_EMBEDDING_MODEL=text-embedding-004
USE_FAKE_EMBEDDINGS=true

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# Nodemailer (Gmail SMTP)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password
EMAIL_FROM=Pamudi Restaurant <your_email@gmail.com>

# App
NODE_ENV=development
BACKEND_PORT=3000
FRONTEND_PORT=3001
JWT_SECRET=your_jwt_secret
SEED_VERBOSE=true
